# --- Autenticación (NextAuth) ---
# Secreto para firmar las sesiones JWT. OBLIGATORIO en producción.
# Generá uno con: openssl rand -base64 32
NEXTAUTH_SECRET=

# URL pública del sitio (para callbacks). En Vercel con dominio propio:
NEXTAUTH_URL=https://www.impressivestudio.cl

# --- Vercel Blob ---
# Se agrega automáticamente al conectar un Blob Store en Vercel (Storage -> Create -> Blob).
# Solo hace falta manualmente para correr en local (vercel env pull lo trae).
BLOB_READ_WRITE_TOKEN=

# --- Portal de Agentes (opcional) ---
# API key de Anthropic para el chat de prueba de agentes. Sin ella el resto del
# portal funciona igual y el chat queda deshabilitado con un aviso.
ANTHROPIC_API_KEY=

# --- Reset de contraseña de administrador ---
# Secreto separado (no es la clave de ningún usuario) para poder resetear la
# contraseña de una cuenta vía POST /api/auth/reset-password cuando se pierde
# el acceso y no hay otro admin con sesión activa. Generá uno con:
# openssl rand -base64 32
ADMIN_RESET_SECRET=
